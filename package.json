{
  "name": "tahara",
  "version": "2",
  "description": "Private Islamic Purity Tracker",
  "main": "index.js",
  "scripts": {
    "generate:sw-manifest": "node scripts/generate-sw-manifest.cjs",
    "dev": "npm run generate:sw-manifest && npm run build:css && npx serve www",
    "build:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --minify",
    "watch:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --watch",
    "build": "npm run generate:sw-manifest && npm run build:css",
    "size": "size-limit",
    "test:unit": "npm run generate:sw-manifest && vitest run engine.test.js backup.test.js db.test.js sw-manifest.test.js",
    "test:e2e": "playwright test",
    "test:security": "vitest run backup.test.js db.test.js && playwright test -g \"Backup Restore Security|Backup Restore UX|Vault Lock State\"",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "size-limit": [
    {
      "path": "www/script.js",
      "limit": "35 kB"
    },
    {
      "path": "www/compiled.css",
      "limit": "20 kB"
    },
    {
      "path": "www/index.html",
      "limit": "25 kB"
    }
  ],
  "author": "Open Waqf Org",
  "license": "Polyform-Noncommercial-1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/local-notifications": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-native-biometric": "^8.4.2",
    "@tailwindcss/cli": "^4.1.18"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.2",
    "@playwright/test": "1.58.2",
    "@size-limit/file": "^11.1.0",
    "serve": "14.2.5",
    "size-limit": "^11.1.0",
    "vitest": "4.0.18"
  }
}
