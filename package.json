{
  "name": "tahara",
  "version": "1.5.0",
  "description": "Private Islamic Purity Tracker",
  "main": "index.js",
  "scripts": {
    "dev": "tailwindcss -i ./www/input.css -o ./www/compiled.css --watch",
    "build:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --minify",
    "watch:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --watch",
    "build": "npm run build:css",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "size-limit": [
    {
      "path": "www/script.js",
      "limit": "35 kB"
    },
    {
      "path": "www/compiled.css",
      "limit": "20 kB"
    },
    {
      "path": "www/index.html",
      "limit": "25 kB"
    }
  ],
  "author": "Open Waqf Org",
  "license": "Polyform-Noncommercial-1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/local-notifications": "8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@tailwindcss/cli": "^4.1.18"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.2",
    "@size-limit/file": "^11.1.0",
    "size-limit": "^11.1.0",
    "vitest": "4.0.18"
  }
}